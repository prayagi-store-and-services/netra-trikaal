<?xml version="1.0" encoding="utf-8"?>
<!-- Birth data and saved profiles stay on this phone. Deny cloud backup AND
     device-to-device transfer for everything (allowBackup=false alone does not
     cover the Android 12+ D2D transfer path). -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
    </cloud-backup>
    <device-transfer>
    </device-transfer>
</data-extraction-rules>
