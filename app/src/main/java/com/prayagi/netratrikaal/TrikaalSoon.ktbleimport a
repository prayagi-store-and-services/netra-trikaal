/** A planned Trikaal feature. The date is a plan estimate (date only, no invented hour). If work slips, change the date in a new release. */
private data class PlannedFeature(val title: String, val note: String)

private val PLANNED = listOf(
    PlannedFeature("Match Making (Kundli Milan)", "Ashtakoota 36 guna plus a Manglik check, with the rule and its source shown."),
    PlannedFeature("Kundli PDF", "Download your kundli as a PDF with the Ganesh ji image on top and the app name, logo and download time in the footer."),
    PlannedFeature("Tithi food guide", "For each tithi: what to avoid eating, what to eat, and its phal."),
    PlannedFeature("Face and palm reading", "Guided capture, gender first, then the hand.")
)

/** Floating button on the kundli view. The PDF export is a future plan and is not built yet, so the button says so plainly. */
@Composable fun KundliPdfSoon() {
    var show by remember { mutableStateOf(false) }
    Column(Modifier.fillMaxWidth(), horizontalAlignment = androidx.compose.ui.Alignment.End) {
        if (show) androidx.compose.material3.Surface(shadowElevation = 4.dp, shape = androidx.compose.foundation.shape.RoundedCornerShape(8.dp)) {
            Text("Kundli PDF is a future plan and is not available in this version.", style = MaterialTheme.typography.bodySmall, modifier = Modifier.padding(8.dp))
        }
        androidx.compose.material3.ExtendedFloatingActionButton(onClick = { show = !show }) { Text("Download PDF (future plan)") }
    }
}

/** Future plans. Nothing here works yet and no release date is promised. */
@Composable fun TrikaalSoon() {
    var open by remember { mutableStateOf<String?>(null) }
    Column(verticalArrangement = Arrangement.spacedBy(6.dp)) {
        Text("Future plans", style = MaterialTheme.typography.titleMedium)
        PLANNED.forEach { f ->
            OutlinedCard(Modifier.fillMaxWidth().clickable { open = if (open == f.title) null else f.title }) {
                Column(Modifier.padding(12.dp)) {
                    Text(f.title, style = MaterialTheme.typography.titleSmall)
                    Text("Planned for a later update.", style = MaterialTheme.typography.bodyMedium)
                    if (open == f.title) {
                        Text(f.note, style = MaterialTheme.typography.bodySmall)
                        Text("Not available in this version.", style = MaterialTheme.typography.bodySmall)
                    }
                }
            }
        }
    }
}ndr
