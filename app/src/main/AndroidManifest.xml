<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Optional, asked with a clear yes or no. Used only on the phone; Prayagraj is used if declined. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Only for the optional "Check for update" button in Settings. It reads the latest version from GitHub when you tap it, and about every 6 hours in the background (only when the phone is online) to save a new version so installing is one tap. No personal data is sent. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the update button hand the downloaded, checksum-verified file to the Android installer. Android still asks you to confirm. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Asked once on Android 13+. Used only to tell you that a new version has been downloaded and is ready to install. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Netra Trikaal"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetraTrikaal">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="prayagi-store-and-services.github.io"
                    android:pathPrefix="/netra-eco/app/trikaal" />
            </intent-filter>
        </activity>
        <provider
            android:name="com.prayagi.netratrikaal.update.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
